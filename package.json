{
  "name": "chaingpt-litellm",
  "version": "0.2.0",
  "description": "OpenAI / LiteLLM-compatible proxy for ChainGPT Web3 LLM (general_assistant)",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "chaingpt-litellm": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env.local --env-file=.env dist/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:live": "bash examples/live-canary.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
