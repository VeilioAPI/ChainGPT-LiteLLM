# Required: ChainGPT API key (server-side only, never expose to browsers)
CHAINGPT_API_KEY=cgpt_your_key_here

# Optional
CHAINGPT_BASE_URL=https://api.chaingpt.org
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8787
# Default chatHistory for agent workloads (off = cheaper, no session)
CHAINGPT_CHAT_HISTORY=off
# Soft warning threshold (logged); hard refuse if exceeded when set
MAX_CREDITS_PER_JOB=
LOG_LEVEL=info
